# Copia este archivo a .env y rellena con tus valores

# ─── BASE DE DATOS ───
DB_HOST=tu-servidor-mysql.ejemplo.com
DB_USER=dbuser
DB_PASSWORD=TuContraseñaSegura123!
DB_NAME=stayevent_db
DB_PORT=3306

# ─── SERVIDOR ───
PORT=3000
NODE_ENV=production

# ─── JWT (SEGURIDAD) ───
JWT_SECRET=tu-clave-secreta-muy-segura-minimo-32-caracteres-aleatorios

# ─── CORS ───
